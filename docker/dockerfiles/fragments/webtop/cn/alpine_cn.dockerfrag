RUN apk add --no-cache curl ca-certificates bash

RUN curl -fsSL https://linuxmirrors.cn/main.sh | bash -s -- \
    --source mirrors.aliyun.com \
    --protocol https \
    --use-intranet-source false \
    --backup false \
    --upgrade-software false \
    --clean-cache false \
    --lang en \
    --pure-mode
